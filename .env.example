# Copy to .env.local and fill in from your Supabase project
# (Dashboard -> Project Settings -> API).
#
# Leave these unset and Circles falls back to a browser-local store, which is
# handy for a first look but does not sync between devices.
#
# The anon key is meant to be public — it ships inside the browser bundle.
# Row level security, defined in supabase/schema.sql, is what protects the data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
